class Solution {
    public int minOperations(int[] nums, int x) {
        int n = nums.length;
        int total = 0;
        for(int i=0;i<n;i++){
            total+= nums[i];
        }
        int target = total - x;
        if(x>total){
            return -1;
        }
        if(total == x){
            return n;
        }
        int i=0;
        int j=0;
        int sum = 0;
        int result =-1;
        while(j<n){
            sum += nums[j];
            while(sum>target){
                sum -= nums[i];
                i++;
            }
            if(sum == target ){
                result  = Math.max(result, j-i+1);
            }
            j++;
        }
        return result == -1 ? -1 : n - result;

    }
}
