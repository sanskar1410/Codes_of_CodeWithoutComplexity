Java Solution
Time Complexity - O(n^2)
Space Complexity - O(n)
**************************************************************************************************************************************************************
class Solution {
    public int sumCounts(List<Integer> nums) {
        int n = nums.size();
        int sum =0;
        for(int i=0;i<n;i++){
            HashSet<Integer> hm = new HashSet<>();
            for(int j =i;j<n;j++){
                hm.add(nums.get(j));
                int distinct = hm.size();
                sum+= distinct * distinct;
            }
        }
        return sum;
    }
}
