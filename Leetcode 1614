class Solution {
    public int maxDepth(String s) {
        int curr =0;
        int result = 0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)=='('){
                curr++;
                result = Math.max(result,curr);
            }else if(s.charAt(i)==')'){
                curr--;
            }
        }
        return result;
    }
}
