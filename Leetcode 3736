Java Solution
Time Complexity - O(n)
Space Complexity - O(1)
**************************************************************************************************************************************************************
class Solution {
    public int minMoves(int[] nums) {
        int move =0;
        int max =nums[0];
        for(int i : nums) max = Math.max(max,i);
        for(int i : nums){
            move+=max-i;
        }
        return move;
    }
}
