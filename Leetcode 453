Java Solution
Time Complexity - O(n)
Space Complexity - O(1)
**************************************************************************************************************************************************************
class Solution {
    public int minMoves(int[] nums) {
        int min = nums[0];
        for(int i : nums) min = Math.min(min,i);
        int result =0 ;
        for(int i : nums) result += i - min;
        return result;
    }
}
