Java Solution
Time Complexity - O(n)
Space Complexity - O(n)
**************************************************************************************************************************************************************
class Solution {
    public List<Integer> targetIndices(int[] nums, int target) {
        ArrayList<Integer> answer= new ArrayList<>();
        int small =0;
        int equal =0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]<target){
                small++;
            }else if(nums[i]==target){
                equal++;
            }
        }
        for(int i=small;i<small+equal;i++){
            answer.add(i);
        }
        return answer;
    }
}
