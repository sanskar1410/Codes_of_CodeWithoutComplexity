Java Solution
Time Complexity - O(nlogn)
Space Complexity - O(1)
**************************************************************************************************************************************************************
class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        for(int i=0;i<n;i++){
            nums[i] *= nums[i];
        }
        Arrays.sort(nums);
        long large = Arrays.stream(nums,n/2,n).asLongStream().sum();
        long small = Arrays.stream(nums,0,n/2).asLongStream().sum();
        return large - small;
    }
}
