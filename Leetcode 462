Java Solution
Time Complexity - O(nlogn)
Space Complexity - O(1)
**************************************************************************************************************************************************************
class Solution {
    public int minMoves2(int[] nums) {
        Arrays.sort(nums);
        int midind  = nums.length/2;
        int result = 0;
        for(int i=0;i<nums.length;i++){
            result += Math.abs(nums[midind]-nums[i]);
        }
        return result;
    }
}
