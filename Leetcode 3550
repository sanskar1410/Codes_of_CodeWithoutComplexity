Java Solution

Approach 1
******************************************************************************************************************
class Solution {
    public int smallestIndex(int[] nums) {
        int result = Integer.MAX_VALUE;
        for(int i=0;i<nums.length;i++){
            int curr = nums[i];
            int sum = 0;
            while(curr>0){
                sum += curr%10;
                curr /= 10;
            }
            if(sum==i){
                result = Math.min(result,i);
            }
        }
        return result == Integer.MAX_VALUE ? -1 : result;
    }
}

Approach 2
******************************************************************************************************************
class Solution {
    public int smallestIndex(int[] nums) {
        int result = Integer.MAX_VALUE;
        for(int i=0;i<nums.length;i++){
            int curr = nums[i];
            int sum = 0;
            int ones = curr%10;
            int tens = (curr/10)%10;
            int hund = (curr/100)%10;
            int thou = (curr/1000)%10;
            sum = ones + tens +hund + thou;
            if(sum==i){
                result = Math.min(result,i);
            }
        }
        return result == Integer.MAX_VALUE ? -1 : result;
    }
}
