Java Solution 
************************************************************************************************************************************
class Solution {
    public long[] resultArray(int[] nums, int k) {
        int n = nums.length;
        int[][] dp = new int[n][k];
        for( int i =0;i<n;i++){
            dp[i][nums[i]%k]++;
            if(i==0) continue;
            for(int r = 0;r<k;r++){
                int newrem = (int)((long)r * nums[i]%k);
                dp[i][newrem] += dp[i-1][r];
            }
        }
        long[] res = new long[k];
        for(int i =0;i<n;i++){
            for(int r =0;r<k;r++){
                res[r] += dp[i][r];
            }
        }
        return res;
    }

}
