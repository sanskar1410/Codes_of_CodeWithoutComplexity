class Solution {
    public String removeOuterParentheses(String s) {
        int depth =0;
        StringBuilder s1 = new StringBuilder();
        for(char ch : s.toCharArray()){
            if(ch == '('){
                if(depth>0){
                    s1.append(ch);
                }
                depth++;
            }else{
                depth--;
                if(depth>0){
                    s1.append(ch);
                }
            }
        }
        return s1.toString();
    }
}
