Java Solution :-

class Solution {
    public boolean checkOverlap(int radius, int xCenter, int yCenter, int x1, int y1, int x2, int y2) {
        int dx = Math.max(x1,Math.min(x2,xCenter));
        int dy = Math.max(y1,Math.min(y2,yCenter));

        int x = xCenter - dx;
        int y = yCenter - dy;
         
        int dist = x*x + y * y;

        if(dist<= radius*radius){
            return true;
        }
        return false;
    }
}

